# Copy this file to .env and fill in your values
APP_NAME="AI Mentor & Growth Planning System"
APP_VERSION="0.1.0"
DEBUG=false

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_mentor_db

ALLOWED_ORIGINS=["http://localhost:5173"]

# OpenAI-compatible provider settings (Ark/Zhipu/etc.)
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
RUN_LIVE_AI_TESTS=0

# UKL: when true, profile dual-write + chat/breakdown/action_plan context packaging
UKL_ENABLED=false
# CHAT_WORK_MEMORY_MAX_MESSAGES=12
# CHAT_SUMMARY_USE_THRESHOLD=16
# CHAT_SESSION_SUMMARY_ENABLED=true
# BREAKDOWN_SUMMARY_ENABLED=true
# ACTION_PLAN_COVERAGE_VALIDATION_ENABLED=true

# Chat system prompts (optional overrides; defaults live in app/core/config.py)
# Runtime priority: admin panel DB config > .env > config.py default
# LLM_SYSTEM_PROMPT=
# ADMIN_LLM_SYSTEM_PROMPT=

# JWT auth settings
AUTH_SECRET_KEY="change-me-in-production-with-a-long-secret-key"
AUTH_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Optional startup admin bootstrap
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_FULL_NAME="System Administrator"
